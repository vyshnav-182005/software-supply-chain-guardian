# Copy to backend/.env (gitignored) and fill in. Only the key is required for AI explanations;
# without it every agent still runs with rule-based results.
GROQ_API_KEY=
# Any OpenAI-compatible endpoint works:
# GUARDIAN_LLM_BASE_URL=https://api.groq.com/openai/v1
# GUARDIAN_LLM_MODEL=llama-3.3-70b-versatile   (default; e.g. openai/gpt-oss-20b also works on Groq)
# GUARDIAN_OSV_OFFLINE=1
# Optional: raises GitHub API limit for changelog lookups (Recommend Fix)
# GITHUB_TOKEN=
# Build, run & verify: where the fixed app is installed, built, started and tested.
#   local  (default) on this machine: fast, reuses the npm/uv caches, but runs the repo's own code WITHOUT
#          a sandbox, so use it for repos you trust
#   docker in the Docker sandbox (start Docker Desktop first): slower, isolated
# GUARDIAN_RUNNER=local
# Port the fixed app is served on:
# GUARDIAN_APP_PORT=3001
# Max seconds for install + build + tests together:
# GUARDIAN_VALIDATE_TIMEOUT=1200
# Recommend Fix checks every package fix with an npm dry run (adds a few minutes to a scan). Turn off with:
# GUARDIAN_FIX_DRYRUN=off
